# ==========================================
# AstraFlare - Git Ignore Rules
# ==========================================

# 1. Environment & Secret Keys (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 2. Node.js Dependencies & Cache
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# 3. Build & Compiled Outputs
**/dist/
**/build/
**/out/
*.tsbuildinfo

# 4. Python Bytecode & Virtual Environments
**/__pycache__/
*.py[cod]
*$py.class
**/.venv/
**/venv/
**/env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# 5. Local Databases & Logs
*.db
*.sqlite
*.sqlite3
*.log
logs/

# 6. Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# 7. Large Data Archives (>50MB)
ml/data/raw/
ml/data/staging/
ml/data/processed/event_dataset/
ml/data/processed/phase1_clean_dataset/

